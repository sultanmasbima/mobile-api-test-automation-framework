<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Main suite. data-provider-thread-count = how many scenarios run in parallel per runner -->
<suite name="Automation Portfolio - Full Regression" data-provider-thread-count="3">
    <test name="API">
        <classes>
            <class name="runners.ApiRunner"/>
        </classes>
    </test>
    <test name="Web">
        <classes>
            <class name="runners.WebRunner"/>
        </classes>
    </test>
</suite>
